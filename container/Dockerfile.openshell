# syntax=docker/dockerfile:1
# AI Guardian OpenShell sandbox image
#
# This image is deliberately separate from container/Dockerfile. The normal
# UBI image remains the supported Docker/Podman support container; this image
# layers AI Guardian on top of the OpenShell Community base so its bundled
# agent paths and default sandbox layout stay aligned with OpenShell.
#
# Build from the repository root with the container directory as context:
#   podman build -f container/Dockerfile.openshell \
#       -t localhost/ai-guardian-openshell:latest container/
#
# Run with the AI Guardian sandbox command:
#   ai-guardian sandbox create --runtime openshell --base localhost/ai-guardian-openshell:latest

# Keep rebuilds reproducible: update this digest deliberately after reviewing
# the new OpenShell Community base and rerunning the image smoke tests.
ARG BASE_IMAGE=ghcr.io/nvidia/openshell-community/sandboxes/base@sha256:aeef1c63f00e2913ea002ccb3aaf925f338b5c5d70e63576f0d95c16a138044e
FROM ${BASE_IMAGE}

ARG AI_GUARDIAN_VERSION=1.18.0
# Keep the OpenShell image's explicitly refreshed clients current while making
# every upgrade reproducible. Claude Code and GitHub Copilot are inherited
# unchanged from the OpenShell Community base image.
ARG CODEX_VERSION=0.154.0
ARG OPENCODE_VERSION=1.18.31
ARG PI_VERSION=0.86.0

# The community base image already supplies the supported CLI agents, Node,
# Git, gh, iproute2, users, and the default OpenShell policy. Install the
# small search utilities Pi expects, then add the AI Guardian runtime and
# scanner engines here.
USER root

# Keep the complete system PATH during build-time scanner setup as well as at
# runtime. The community base already includes utilities such as blkid under
# /usr/sbin; omitting sbin here makes ONNX Runtime emit a misleading warning.
ENV PATH=/sandbox/.venv/bin:/sandbox/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

# Pi otherwise attempts runtime downloads for these tools, which are not
# available through the sandbox's deliberately narrow egress policy.
RUN apt-get update \
    && apt-get install --no-install-recommends --yes fd-find ripgrep \
    && ln -sf /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

COPY vendor/ /tmp/ai-guardian-vendor/

RUN set -eux; \
    case "${AI_GUARDIAN_VERSION}" in \
        *.whl) \
            wheel="/tmp/ai-guardian-vendor/${AI_GUARDIAN_VERSION}"; \
            test -f "$wheel"; \
            uv pip install --python /sandbox/.venv/bin/python \
                "$wheel" rapidocr-onnxruntime==1.4.4 ;; \
        *) \
            uv pip install --python /sandbox/.venv/bin/python \
                "ai-guardian==${AI_GUARDIAN_VERSION}" \
                rapidocr-onnxruntime==1.4.4 ;; \
    esac; \
    rm -rf /tmp/ai-guardian-vendor; \
    ln -sf /sandbox/.venv/bin/ai-guardian /usr/local/bin/ai-guardian; \
    ai-guardian --version

# Keep the proprietary clients supplied by the base image available without
# downloading or modifying them in this derived image.
RUN set -eux; \
    command -v claude; \
    command -v copilot; \
    claude --version; \
    copilot --version

# Refresh only the explicitly managed Node-based clients so their model
# catalogs, protocol support, and command paths stay aligned with the current
# CLI releases; Claude and Copilot remain unchanged from the base image.
RUN npm install --global --prefix /usr --no-fund --no-audit \
        "@openai/codex@${CODEX_VERSION}" \
        "opencode-ai@${OPENCODE_VERSION}" \
        "@earendil-works/pi-coding-agent@${PI_VERSION}" \
    && codex --version \
    && opencode --version \
    && pi --version

# Avoid pulling X11 libraries into the headless support image through the
# OCR dependency, matching the normal UBI image's runtime choice.
RUN uv pip uninstall --python /sandbox/.venv/bin/python opencv-python || true \
    && uv pip install --python /sandbox/.venv/bin/python opencv-python-headless

# Install the same pinned scanner engines as the normal image, except for
# TruffleHog, whose license acknowledgement requires an interactive install.
# These tools are present before OpenShell starts, so no runtime egress policy
# is needed for scanner downloads.
RUN ai-guardian scanner install gitleaks --use-pinned \
    && test -x /usr/local/bin/gitleaks \
    && ai-guardian scanner install betterleaks --use-pinned \
    && test -x /usr/local/bin/betterleaks \
    && ai-guardian scanner install leaktk --use-pinned \
    && test -x /usr/local/bin/leaktk \
    && ai-guardian scanner install secretlint --use-pinned \
    && test -x /usr/local/bin/secretlint \
    && ai-guardian scanner install gitguardian --use-pinned \
    && test -x /usr/local/bin/ggshield

# Install the pinned detect-secrets Python package in the sandbox-local uv tool
# directory, which is already included in the runtime PATH and writable home.
RUN set -eux; \
    DETECT_SECRETS_VERSION=$(/sandbox/.venv/bin/python -c \
        "from ai_guardian.scanners.installer import ScannerInstaller; print(ScannerInstaller().get_pinned_version('detect-secrets'))"); \
    test -n "$DETECT_SECRETS_VERSION"; \
    test "$DETECT_SECRETS_VERSION" != unknown; \
    UV_TOOL_DIR=/sandbox/.local/share/uv/tools \
        UV_TOOL_BIN_DIR=/sandbox/.local/bin \
        uv tool install --python /sandbox/.venv/bin/python \
            "detect-secrets==${DETECT_SECRETS_VERSION}"; \
    test -x /sandbox/.local/bin/detect-secrets

# Keep all runtime state and configuration in the writable sandbox home. The
# host configuration, when selected by the sandbox command, is uploaded separately.
RUN mkdir -p \
        /sandbox/.config/ai-guardian/profiles \
        /sandbox/.claude /sandbox/.cursor /sandbox/.codex \
        /sandbox/.gemini /sandbox/.github/hooks \
        /sandbox/.kiro /sandbox/.openclaw /sandbox/.cline \
        /sandbox/.clinerules /sandbox/.junie /sandbox/.aider-desk \
        /sandbox/.augment /sandbox/.crush /sandbox/.pi/agent \
        /sandbox/.local/bin /sandbox/.local/state/ai-guardian \
    && chown -R sandbox:sandbox \
        /sandbox/.config /sandbox/.claude /sandbox/.cursor /sandbox/.codex \
        /sandbox/.gemini /sandbox/.github /sandbox/.kiro /sandbox/.openclaw \
        /sandbox/.cline /sandbox/.clinerules /sandbox/.junie \
        /sandbox/.aider-desk /sandbox/.augment /sandbox/.crush /sandbox/.pi \
        /sandbox/.local

# OpenShell currently supplies a reduced PATH without /usr/sbin. ONNX Runtime
# probes the container with blkid, so expose the base image's existing utility
# through a directory that remains on OpenShell's PATH.
RUN ln -sf /usr/sbin/blkid /usr/local/bin/blkid

COPY entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 755 /usr/local/bin/entrypoint.sh

ARG AI_GUARDIAN_REST_PORT=63152
ENV AI_GUARDIAN_REST_PORT=${AI_GUARDIAN_REST_PORT} \
    AI_GUARDIAN_HOME=/sandbox/.config/ai-guardian \
    HOME=/sandbox \
    PI_CODING_AGENT_DIR=/sandbox/.pi/agent \
    PATH=/sandbox/.venv/bin:/sandbox/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

LABEL ai-guardian.daemon=true \
      ai-guardian.support-image=true \
      ai-guardian.openshell-base=true \
      ai-guardian.compatibility-report-schema=1 \
      ai-guardian.version="${AI_GUARDIAN_VERSION}" \
      ai-guardian.openshell.base-image="${BASE_IMAGE}" \
      ai-guardian.openshell.claude-version="inherited-from-base" \
      ai-guardian.openshell.copilot-version="inherited-from-base" \
      ai-guardian.openshell.codex-version="${CODEX_VERSION}" \
      ai-guardian.openshell.opencode-version="${OPENCODE_VERSION}" \
      ai-guardian.openshell.pi-version="${PI_VERSION}"

EXPOSE ${AI_GUARDIAN_REST_PORT}

WORKDIR /sandbox
USER sandbox

ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
CMD ["bash", "-l"]
